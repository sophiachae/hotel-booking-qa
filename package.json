{
  "name": "mini-hotel-booking",
  "version": "1.1.0",
  "description": "QA 포트폴리오용 미니 호텔 예약 웹앱 (테스트 대상 애플리케이션)",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "reset": "node scripts/reset-db.js",
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:report": "playwright show-report",
    "test:watch": "playwright test --project=ui --headed --workers=1",
    "test:debug-ui": "playwright test --ui",
    "pii:check": "node scripts/check-pii.js",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5"
  }
}
